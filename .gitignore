# Files inside Physics_World_Model/ that should NOT go to the public GitHub repo.
# Add any file or folder here to keep it local/private only.

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# IDE / editor / tool state
.claude/
.idea/
.vscode/
*.swp
*.swo

# OS artifacts
NUL
bash.exe.stackdump
Thumbs.db
.DS_Store

# Paper source files (kept in pwm/papers/ instead)
**/*.pdf
**/*.tex

# Paper build artifacts
**/*.aux
**/*.log
**/*.out
**/*.toc
**/*.blg
**/*.bbl
**/*.synctex.gz

# Paper archive / submission zips
papers/**/*.zip
papers/**/*.tar.gz
papers/**/talk_*.pptx
papers/universal_simulation/zenodo_archive/code/pwm_core/weights/
papers/universal_simulation/zenodo_archive/data/
papers/universal_simulation/zenodo_archive/code/pwm_core/pwm_core/data/
papers/universal_simulation/zenodo_archive/code/pwm_core/benchmarks/last_run.log
papers/inversenet/results/
papers/inversenet/data/spc/models/
papers/inversenet/eccv_resubmission/
papers/pwmi_cassi/results/
papers/system_design/outputs/*.npz

# Private co-author strategy
papers/pwm_flagship/thoughts/
papers/pwm_flagship/contribution_packages/

# Pitch deck
pitch_deck/

# Heavy local data (served from GCS, except reference-solver weights below).
# Use `weights/*` (single-level) instead of `weights/` (recursive) so
# the `!` exceptions below can re-include the specific reference-solver
# weight files. A recursive directory ignore can't be overridden.
packages/pwm_core/pwm_core/weights/
packages/pwm_core/weights/*
# Reference-solver weights are committed via Git LFS so a fresh clone
# can run cassi_mst.py + cacti_efficientsci.py without a separate
# download step. Keep these `!` exceptions in sync with the LFS
# tracking patterns in .gitattributes.
!packages/pwm_core/weights/mst/
!packages/pwm_core/weights/mst/*.pth
!packages/pwm_core/weights/efficientsci/
!packages/pwm_core/weights/efficientsci/*.pth
checkpoint/
datasets/benchmark/**/public/
datasets/benchmark/**/dev/
datasets/benchmark/**/hidden/
datasets/benchmark/**/standard/
datasets/inversenet_cacti/
datasets/inversenet_cassi/
datasets/inversenet_spc/
datasets/lip_arena/
datasets/real_ct/
datasets/real_mri/

# Reference model weights (all formats)
reference/**/*.pth
reference/**/*.pt
reference/**/*.npz
reference/**/*.pkl
reference/**/*.zip
reference/ct/
reference/mri/

# Platform data
platform/pwm_platform/static/benchmark-data/v1.0/*.tar.gz
platform/pwm_platform/data/benchmarks/*.npz

# Local dataset files
datasets/SPC/BSDS400/
datasets/benchmark/fpm/
datasets/benchmark/fmri/*.json
datasets/benchmark/build_*.py
datasets/benchmark/generate_*.py
datasets/benchmark/README.md
datasets/benchmark/challenge-data/
datasets/benchmark/gallery/
datasets/benchmark/**/baseline_summary.json
datasets/benchmark/mri/*.py
datasets/benchmark/*/
!datasets/benchmark/cassi/
!datasets/benchmark/cassi/manifest.json

# Benchmark results (local verification)
benchmark_results/

# Temp / scratch dirs
hisvit_temp/
test_runs/
test_runs_pnp/
test_impl/
test_pnp_all/
runs/
repos/

# One-off scripts (keep only committed ones)
scripts/add_baselines.py
scripts/llm_benchmark_eval/results/
