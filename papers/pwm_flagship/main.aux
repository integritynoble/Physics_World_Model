\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {PWM overview.} The Physics World Models pipeline. \textbf  {a},~A computational imaging system is provided as input. \textbf  {b},~The system is compiled into an \textsc  {OperatorGraph}{} DAG over the 11 universal primitives. \textbf  {c},~The \textsc  {Triad Decomposition}{} diagnostic agents evaluate each gate and produce a \textsc  {TriadReport}{}. \textbf  {d},~Based on the dominant gate, targeted intervention is applied: calibration for Gate~3, acquisition redesign for Gate~1, or source/detector improvement for Gate~2. \textbf  {e},~The original solver is re-run with the corrected operator, recovering reconstruction quality without retraining. \textbf  {f},~The 11 universal primitives ($P$, $C$, $M$, $R$, $\Lambda $, $\Pi $, $F$, $\Sigma $, $S$, $W$, $D$) form a finite, complete alphabet: any imaging modality---existing or yet to be invented---can be auto-composed as a typed DAG over this basis, enabling automatic forward-model design without manual physics derivation.}}{40}{figure.caption.122}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{40}{\textbf {PWM overview.} The Physics World Models pipeline. \textbf {a},~A computational imaging system is provided as input. \textbf {b},~The system is compiled into an \opg {} DAG over the 11 universal primitives. \textbf {c},~The \triad {} diagnostic agents evaluate each gate and produce a \triadreport {}. \textbf {d},~Based on the dominant gate, targeted intervention is applied: calibration for Gate~3, acquisition redesign for Gate~1, or source/detector improvement for Gate~2. \textbf {e},~The original solver is re-run with the corrected operator, recovering reconstruction quality without retraining. \textbf {f},~The 11 universal primitives ($P$, $C$, $M$, $R$, $\Lambda $, $\Pi $, $F$, $\Sigma $, $S$, $W$, $D$) form a finite, complete alphabet: any imaging modality---existing or yet to be invented---can be auto-composed as a typed DAG over this basis, enabling automatic forward-model design without manual physics derivation}{figure.caption.122}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][40][]40}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {OperatorGraph IR and Physics Fidelity Ladder.} \textbf  {a},~Example \textsc  {OperatorGraph}{} DAGs for three modalities: CASSI (photon), MRI (spin), and CT (X-ray photon). Each node wraps a primitive operator; edges define data flow. \textbf  {b},~Fidelity levels: forward models range from linear shift-invariant (simplest) through nonlinear and full-wave; all 11 primitives apply uniformly across every level. \textbf  {c},~Summary statistics: 168 registered modality templates across 19 categories (12 with full correction validation), 5 physical carriers.}}{41}{figure.caption.123}\protected@file@percent }
\newlabel{fig:operatorgraph}{{2}{41}{\textbf {OperatorGraph IR and Physics Fidelity Ladder.} \textbf {a},~Example \opg {} DAGs for three modalities: CASSI (photon), MRI (spin), and CT (X-ray photon). Each node wraps a primitive operator; edges define data flow. \textbf {b},~Fidelity levels: forward models range from linear shift-invariant (simplest) through nonlinear and full-wave; all 11 primitives apply uniformly across every level. \textbf {c},~Summary statistics: 168 registered modality templates across 19 categories (12 with full correction validation), 5 physical carriers}{figure.caption.123}{}}
\newlabel{fig:operatorgraph@cref}{{[figure][2][]2}{[1][40][]41}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Triad Decomposition structure and gate binding.} \textbf  {a},~Decision tree for the \textsc  {Triad Decomposition}{}: each imaging failure is routed through \textbf  {Gate\,1}{}, \textbf  {Gate\,2}{}, and \textbf  {Gate\,3}{} to produce a \textsc  {TriadReport}{}. \textbf  {b},~Gate binding heatmap across 14 correction configurations (12 distinct modalities, 5 carrier families). Red indicates \textbf  {Gate\,3}{} dominance (all 14/14 configurations), blue indicates \textbf  {Gate\,1}{}, and amber indicates \textbf  {Gate\,2}{}. \textbf  {c},~Recovery ratio $\rho $ distribution across all 14 correction configurations, demonstrating that Gate~3 dominance holds universally across optical-photon, X-ray-photon, electron, nuclear-spin, and acoustic-wave carriers.}}{42}{figure.caption.124}\protected@file@percent }
\newlabel{fig:triad}{{3}{42}{\textbf {Triad Decomposition structure and gate binding.} \textbf {a},~Decision tree for the \triad {}: each imaging failure is routed through \gateone {}, \gatetwo {}, and \gatethree {} to produce a \triadreport {}. \textbf {b},~Gate binding heatmap across 14 correction configurations (12 distinct modalities, 5 carrier families). Red indicates \gatethree {} dominance (all 14/14 configurations), blue indicates \gateone {}, and amber indicates \gatetwo {}. \textbf {c},~Recovery ratio $\recoveryratio $ distribution across all 14 correction configurations, demonstrating that Gate~3 dominance holds universally across optical-photon, X-ray-photon, electron, nuclear-spin, and acoustic-wave carriers}{figure.caption.124}{}}
\newlabel{fig:triad@cref}{{[figure][3][]3}{[1][40][]42}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Cross-modality mismatch correction: the centerpiece experiment.} \textbf  {a},~PSNR across the 4-Scenario Protocol for all 12 validated modalities, grouped by carrier family: optical photons (CASSI, CACTI, SPC, lensless, compressive holography, fluorescence microscopy), X-ray photons (CT, CBCT), electrons (ptychography, cryo-EM), nuclear spins (MRI), and acoustic waves (ultrasound). For each modality, four bars show: Scenario~I (ideal, ceiling), Scenario~II (mismatched, floor), Scenario~III (oracle correction ceiling), and Scenario~IV (Corrected: ESPIRiT for MRI, ePIE for ptychography, grid-search for all others). Error bars show 95\% bootstrap CIs over test scenes. The gap between Scenario~I and~II is the mismatch-induced degradation; the gap between Scenario~II and~IV is the autonomous recovery. In 10 of 12 modalities, a simple solver on the corrected operator (Scenario~IV) outperforms the best available solver on the mismatched operator (Scenario~II), demonstrating that calibration beats solver upgrades. \textbf  {b},~Zero-shot generalization: hyperparameters tuned on photon-domain modalities (CASSI, CACTI, SPC) transfer without modification to coherent-photon, spin, X-ray, electron, and acoustic domains, with comparable correction gains ($< 0.5$\,dB difference). Dark bars: modality-specific tuning; light bars: zero-shot transfer.}}{43}{figure.caption.125}\protected@file@percent }
\newlabel{fig:correction_zeroshot}{{4}{43}{\textbf {Cross-modality mismatch correction: the centerpiece experiment.} \textbf {a},~PSNR across the 4-Scenario Protocol for all 12 validated modalities, grouped by carrier family: optical photons (CASSI, CACTI, SPC, lensless, compressive holography, fluorescence microscopy), X-ray photons (CT, CBCT), electrons (ptychography, cryo-EM), nuclear spins (MRI), and acoustic waves (ultrasound). For each modality, four bars show: Scenario~I (ideal, ceiling), Scenario~II (mismatched, floor), Scenario~III (oracle correction ceiling), and Scenario~IV (Corrected: ESPIRiT for MRI, ePIE for ptychography, grid-search for all others). Error bars show 95\% bootstrap CIs over test scenes. The gap between Scenario~I and~II is the mismatch-induced degradation; the gap between Scenario~II and~IV is the autonomous recovery. In 10 of 12 modalities, a simple solver on the corrected operator (Scenario~IV) outperforms the best available solver on the mismatched operator (Scenario~II), demonstrating that calibration beats solver upgrades. \textbf {b},~Zero-shot generalization: hyperparameters tuned on photon-domain modalities (CASSI, CACTI, SPC) transfer without modification to coherent-photon, spin, X-ray, electron, and acoustic domains, with comparable correction gains ($< 0.5$\,dB difference). Dark bars: modality-specific tuning; light bars: zero-shot transfer}{figure.caption.125}{}}
\newlabel{fig:correction_zeroshot@cref}{{[figure][4][]4}{[1][40][]43}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Modality deep dives and visual comparison.} \textbf  {a},~CASSI: PSNR across 4 scenarios for GAP-TV, MST-L, and HDNet; uniform collapse under Scenario~II ($20.83$--$21.88$\,dB) confirms operator-driven failure. \textbf  {b},~CACTI: four methods across 4 scenarios, showing up to $20.58$\,dB mismatch degradation. \textbf  {c--e},~Visual comparison (CASSI, CACTI, MRI): ground truth, Scenario~I, II (structured artifacts), III (Oracle-corrected), and error map.}}{44}{figure.caption.126}\protected@file@percent }
\newlabel{fig:deepdive_visual}{{5}{44}{\textbf {Modality deep dives and visual comparison.} \textbf {a},~CASSI: PSNR across 4 scenarios for GAP-TV, MST-L, and HDNet; uniform collapse under Scenario~II ($20.83$--$21.88$\,dB) confirms operator-driven failure. \textbf {b},~CACTI: four methods across 4 scenarios, showing up to $20.58$\,dB mismatch degradation. \textbf {c--e},~Visual comparison (CASSI, CACTI, MRI): ground truth, Scenario~I, II (structured artifacts), III (Oracle-corrected), and error map}{figure.caption.126}{}}
\newlabel{fig:deepdive_visual@cref}{{[figure][5][]5}{[1][40][]44}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Hardware validation on real CASSI and CACTI instruments.} \textbf  {a},~CASSI real data: measurement residual ratio (mismatched/calibrated) across 5 TSA scenes. GAP-TV shows $1.8\times $ mean ratio. \textbf  {b},~CACTI real data: residual ratio across 4 scenes. GAP-TV shows $10.4\times $ mean ratio; PnP-FFDNet shows $2.0\times $. \textbf  {c},~Simulation-to-hardware gap: comparing mismatch degradation in simulation versus real hardware for CASSI and CACTI. \textbf  {d},~Autonomous calibration: grid-search parameter recovery for CASSI (85\%), CACTI (100\%), and SPC (86--92\%).}}{45}{figure.caption.127}\protected@file@percent }
\newlabel{fig:hardware}{{6}{45}{\textbf {Hardware validation on real CASSI and CACTI instruments.} \textbf {a},~CASSI real data: measurement residual ratio (mismatched/calibrated) across 5 TSA scenes. GAP-TV shows $1.8\times $ mean ratio. \textbf {b},~CACTI real data: residual ratio across 4 scenes. GAP-TV shows $10.4\times $ mean ratio; PnP-FFDNet shows $2.0\times $. \textbf {c},~Simulation-to-hardware gap: comparing mismatch degradation in simulation versus real hardware for CASSI and CACTI. \textbf {d},~Autonomous calibration: grid-search parameter recovery for CASSI (85\%), CACTI (100\%), and SPC (86--92\%)}{figure.caption.127}{}}
\newlabel{fig:hardware@cref}{{[figure][6][]6}{[1][40][]45}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Basis-growth saturation and primitive decomposition.} \textbf  {a},~Number of distinct primitives $K$ as a function of modalities $N$ added to the registry. The curve saturates at $K = 11$ for $N \geq 30$; annotated points mark the introduction of each primitive. \textbf  {b},~Summary decomposition table for representative modalities across five carrier families, showing DAG primitives, node count, depth, and validation status.}}{46}{figure.caption.128}\protected@file@percent }
