\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {PWM overview.} The Physics World Models pipeline. \textbf  {a},~A computational imaging system is compiled into an \textsc  {OperatorGraph}{} DAG. \textbf  {b},~The \textsc  {Triad Decomposition}{} diagnostic agents evaluate each gate. \textbf  {c},~The dominant gate is identified and a \textsc  {TriadReport}{} is produced. \textbf  {d},~If \textbf  {Gate\,3}{} dominates, autonomous correction refines the forward model parameters. \textbf  {e},~The original solver is re-run with the corrected operator, recovering reconstruction quality without retraining.}}{30}{figure.caption.105}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{30}{\textbf {PWM overview.} The Physics World Models pipeline. \textbf {a},~A computational imaging system is compiled into an \opg {} DAG. \textbf {b},~The \triad {} diagnostic agents evaluate each gate. \textbf {c},~The dominant gate is identified and a \triadreport {} is produced. \textbf {d},~If \gatethree {} dominates, autonomous correction refines the forward model parameters. \textbf {e},~The original solver is re-run with the corrected operator, recovering reconstruction quality without retraining}{figure.caption.105}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][30][]30}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {OperatorGraph IR and Physics Fidelity Ladder.} \textbf  {a},~Example \textsc  {OperatorGraph}{} DAGs for three modalities: CASSI (photon), MRI (spin), and CT (X-ray photon). Each node wraps a primitive operator; edges define data flow. \textbf  {b},~The Physics Fidelity Ladder. Tier~1: linear shift-invariant. Tier~2: linear shift-variant. Tier~3: nonlinear ray/wave-based. Tier~4: full-wave/Monte Carlo. \textbf  {c},~Summary statistics: 26 registered modality templates (7 with full correction validation), 5 physical carriers.}}{30}{figure.caption.106}\protected@file@percent }
\newlabel{fig:operatorgraph}{{2}{30}{\textbf {OperatorGraph IR and Physics Fidelity Ladder.} \textbf {a},~Example \opg {} DAGs for three modalities: CASSI (photon), MRI (spin), and CT (X-ray photon). Each node wraps a primitive operator; edges define data flow. \textbf {b},~The Physics Fidelity Ladder. Tier~1: linear shift-invariant. Tier~2: linear shift-variant. Tier~3: nonlinear ray/wave-based. Tier~4: full-wave/Monte Carlo. \textbf {c},~Summary statistics: 26 registered modality templates (7 with full correction validation), 5 physical carriers}{figure.caption.106}{}}
\newlabel{fig:operatorgraph@cref}{{[figure][2][]2}{[1][30][]30}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Triad Decomposition structure and gate binding.} \textbf  {a},~Decision tree for the \textsc  {Triad Decomposition}{}: each imaging failure is routed through \textbf  {Gate\,1}{}, \textbf  {Gate\,2}{}, and \textbf  {Gate\,3}{} to produce a \textsc  {TriadReport}{}. \textbf  {b},~Gate binding heatmap across 9 correction configurations (7 distinct modalities). Red indicates \textbf  {Gate\,3}{} dominance (all modalities), blue indicates \textbf  {Gate\,1}{}, and amber indicates \textbf  {Gate\,2}{}. \textbf  {c},~Recovery ratio $\rho $ distribution across all 9 correction configurations.}}{31}{figure.caption.107}\protected@file@percent }
\newlabel{fig:triad}{{3}{31}{\textbf {Triad Decomposition structure and gate binding.} \textbf {a},~Decision tree for the \triad {}: each imaging failure is routed through \gateone {}, \gatetwo {}, and \gatethree {} to produce a \triadreport {}. \textbf {b},~Gate binding heatmap across 9 correction configurations (7 distinct modalities). Red indicates \gatethree {} dominance (all modalities), blue indicates \gateone {}, and amber indicates \gatetwo {}. \textbf {c},~Recovery ratio $\recoveryratio $ distribution across all 9 correction configurations}{figure.caption.107}{}}
\newlabel{fig:triad@cref}{{[figure][3][]3}{[1][30][]31}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Correction results and zero-shot generalization.} \textbf  {a},~Oracle correction ceiling $\Delta _{\mathrm  {oracle}}$ (dB) across 9 validated configurations (7 distinct modalities), grouped by carrier family. \textbf  {b},~Zero-shot generalization: hyperparameters tuned on photon-domain modalities transfer without modification to coherent-photon, spin, and X-ray domains. Dark bars: modality-specific tuning; light bars: zero-shot transfer.}}{32}{figure.caption.108}\protected@file@percent }
\newlabel{fig:correction_zeroshot}{{4}{32}{\textbf {Correction results and zero-shot generalization.} \textbf {a},~Oracle correction ceiling $\Delta _{\mathrm {oracle}}$ (dB) across 9 validated configurations (7 distinct modalities), grouped by carrier family. \textbf {b},~Zero-shot generalization: hyperparameters tuned on photon-domain modalities transfer without modification to coherent-photon, spin, and X-ray domains. Dark bars: modality-specific tuning; light bars: zero-shot transfer}{figure.caption.108}{}}
\newlabel{fig:correction_zeroshot@cref}{{[figure][4][]4}{[1][30][]32}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Modality deep dives and visual comparison.} \textbf  {a},~CASSI: PSNR across 4 scenarios for GAP-TV, MST-L, and HDNet; uniform collapse under Scenario~II ($20.83$--$21.88$\,dB) confirms operator-driven failure. \textbf  {b},~CACTI: four methods across 4 scenarios, showing up to $20.58$\,dB mismatch degradation. \textbf  {c--e},~Visual reconstruction comparison (CASSI, CACTI, MRI): ground truth, Scenario~I, Scenario~II (structured artifacts), Scenario~III (PWM-corrected), and error map. Mismatch artifacts are qualitatively distinct from noise and substantially reduced by correction.}}{33}{figure.caption.109}\protected@file@percent }
\newlabel{fig:deepdive_visual}{{5}{33}{\textbf {Modality deep dives and visual comparison.} \textbf {a},~CASSI: PSNR across 4 scenarios for GAP-TV, MST-L, and HDNet; uniform collapse under Scenario~II ($20.83$--$21.88$\,dB) confirms operator-driven failure. \textbf {b},~CACTI: four methods across 4 scenarios, showing up to $20.58$\,dB mismatch degradation. \textbf {c--e},~Visual reconstruction comparison (CASSI, CACTI, MRI): ground truth, Scenario~I, Scenario~II (structured artifacts), Scenario~III (PWM-corrected), and error map. Mismatch artifacts are qualitatively distinct from noise and substantially reduced by correction}{figure.caption.109}{}}
\newlabel{fig:deepdive_visual@cref}{{[figure][5][]5}{[1][30][]33}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Hardware validation on real CASSI and CACTI instruments.} \textbf  {a},~CASSI real data: measurement residual ratio (mismatched/calibrated) across 5 TSA scenes. GAP-TV shows $1.8\times $ mean ratio. \textbf  {b},~CACTI real data: residual ratio across 4 scenes. GAP-TV shows $10.4\times $ mean ratio; PnP-FFDNet shows $2.0\times $. \textbf  {c},~Simulation-to-hardware gap: comparing mismatch degradation in simulation versus real hardware for CASSI and CACTI. \textbf  {d},~Autonomous calibration: grid-search parameter recovery for CASSI (85\%), CACTI (100\%), and SPC (86--92\%).}}{34}{figure.caption.110}\protected@file@percent }
\newlabel{fig:hardware}{{6}{34}{\textbf {Hardware validation on real CASSI and CACTI instruments.} \textbf {a},~CASSI real data: measurement residual ratio (mismatched/calibrated) across 5 TSA scenes. GAP-TV shows $1.8\times $ mean ratio. \textbf {b},~CACTI real data: residual ratio across 4 scenes. GAP-TV shows $10.4\times $ mean ratio; PnP-FFDNet shows $2.0\times $. \textbf {c},~Simulation-to-hardware gap: comparing mismatch degradation in simulation versus real hardware for CASSI and CACTI. \textbf {d},~Autonomous calibration: grid-search parameter recovery for CASSI (85\%), CACTI (100\%), and SPC (86--92\%)}{figure.caption.110}{}}
\newlabel{fig:hardware@cref}{{[figure][6][]6}{[1][30][]34}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Basis-growth saturation and primitive decomposition.} \textbf  {a},~Number of distinct primitives $K$ as a function of modalities $N$ added to the registry. The curve saturates at $K = 10$ for $N \geq 27$; annotated points mark the introduction of each primitive. \textbf  {b},~Summary decomposition table for representative modalities across five carrier families, showing DAG primitives, node count, depth, and validation status.}}{35}{figure.caption.111}\protected@file@percent }
\newlabel{fig:basis_growth}{{7}{35}{\textbf {Basis-growth saturation and primitive decomposition.} \textbf {a},~Number of distinct primitives $K$ as a function of modalities $N$ added to the registry. The curve saturates at $K = 10$ for $N \geq 27$; annotated points mark the introduction of each primitive. \textbf {b},~Summary decomposition table for representative modalities across five carrier families, showing DAG primitives, node count, depth, and validation status}{figure.caption.111}{}}
