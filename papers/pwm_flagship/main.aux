\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {PWM overview.} The Physics World Models pipeline. \textbf  {a},~A computational imaging system is compiled into an \textsc  {OperatorGraph}{} DAG. \textbf  {b},~The \textsc  {Triad Decomposition}{} diagnostic agents evaluate each gate. \textbf  {c},~The dominant gate is identified and a \textsc  {TriadReport}{} is produced. \textbf  {d},~If \textbf  {Gate\,3}{} dominates, autonomous correction refines the forward model parameters. \textbf  {e},~The original solver is re-run with the corrected operator, recovering reconstruction quality without retraining.}}{30}{figure.caption.111}\protected@file@percent }
\newlabel{fig:overview}{{1}{30}{\textbf {PWM overview.} The Physics World Models pipeline. \textbf {a},~A computational imaging system is compiled into an \opg {} DAG. \textbf {b},~The \triad {} diagnostic agents evaluate each gate. \textbf {c},~The dominant gate is identified and a \triadreport {} is produced. \textbf {d},~If \gatethree {} dominates, autonomous correction refines the forward model parameters. \textbf {e},~The original solver is re-run with the corrected operator, recovering reconstruction quality without retraining}{figure.caption.111}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][30][]30}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {OperatorGraph IR and Physics Fidelity Ladder.} \textbf  {a},~Example \textsc  {OperatorGraph}{} DAGs for three modalities: CASSI (photon), MRI (spin), and CT (X-ray photon). Each node wraps a primitive operator; edges define data flow. \textbf  {b},~Fidelity levels: forward models range from linear shift-invariant (simplest) through nonlinear and full-wave; all 11 primitives apply uniformly across every level. \textbf  {c},~Summary statistics: 26 registered modality templates (7 with full correction validation), 5 physical carriers.}}{30}{figure.caption.112}\protected@file@percent }
\newlabel{fig:operatorgraph}{{2}{30}{\textbf {OperatorGraph IR and Physics Fidelity Ladder.} \textbf {a},~Example \opg {} DAGs for three modalities: CASSI (photon), MRI (spin), and CT (X-ray photon). Each node wraps a primitive operator; edges define data flow. \textbf {b},~Fidelity levels: forward models range from linear shift-invariant (simplest) through nonlinear and full-wave; all 11 primitives apply uniformly across every level. \textbf {c},~Summary statistics: 26 registered modality templates (7 with full correction validation), 5 physical carriers}{figure.caption.112}{}}
\newlabel{fig:operatorgraph@cref}{{[figure][2][]2}{[1][30][]30}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Triad Decomposition structure and gate binding.} \textbf  {a},~Decision tree for the \textsc  {Triad Decomposition}{}: each imaging failure is routed through \textbf  {Gate\,1}{}, \textbf  {Gate\,2}{}, and \textbf  {Gate\,3}{} to produce a \textsc  {TriadReport}{}. \textbf  {b},~Gate binding heatmap across 9 correction configurations (7 distinct modalities). Red indicates \textbf  {Gate\,3}{} dominance (all modalities), blue indicates \textbf  {Gate\,1}{}, and amber indicates \textbf  {Gate\,2}{}. \textbf  {c},~Recovery ratio $\rho $ distribution across all 9 correction configurations.}}{31}{figure.caption.113}\protected@file@percent }
\newlabel{fig:triad}{{3}{31}{\textbf {Triad Decomposition structure and gate binding.} \textbf {a},~Decision tree for the \triad {}: each imaging failure is routed through \gateone {}, \gatetwo {}, and \gatethree {} to produce a \triadreport {}. \textbf {b},~Gate binding heatmap across 9 correction configurations (7 distinct modalities). Red indicates \gatethree {} dominance (all modalities), blue indicates \gateone {}, and amber indicates \gatetwo {}. \textbf {c},~Recovery ratio $\recoveryratio $ distribution across all 9 correction configurations}{figure.caption.113}{}}
\newlabel{fig:triad@cref}{{[figure][3][]3}{[1][30][]31}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The central experiment: forward-model correction beats solver upgrades across all carrier families.} \textbf  {a},~Peak signal-to-noise ratio (PSNR) across the 4-Scenario Protocol for 7 modalities grouped by carrier family. Error bars: 95\% bootstrap CIs ($B = 1{,}000$). \emph  {Key finding}: in 5 of 7 modalities, a classical solver on the corrected operator (Sc.~III) outperforms the best deep-learning solver on the mismatched operator (Sc.~II). \textbf  {b},~Zero-shot cross-carrier transfer: hyperparameters tuned on photon-domain modalities transfer to X-ray, electron, and spin domains ($< 0.5$\,dB difference).}}{32}{figure.caption.114}\protected@file@percent }
\newlabel{fig:correction_zeroshot}{{4}{32}{\textbf {The central experiment: forward-model correction beats solver upgrades across all carrier families.} \textbf {a},~Peak signal-to-noise ratio (PSNR) across the 4-Scenario Protocol for 7 modalities grouped by carrier family. Error bars: 95\% bootstrap CIs ($B = 1{,}000$). \emph {Key finding}: in 5 of 7 modalities, a classical solver on the corrected operator (Sc.~III) outperforms the best deep-learning solver on the mismatched operator (Sc.~II). \textbf {b},~Zero-shot cross-carrier transfer: hyperparameters tuned on photon-domain modalities transfer to X-ray, electron, and spin domains ($< 0.5$\,dB difference)}{figure.caption.114}{}}
\newlabel{fig:correction_zeroshot@cref}{{[figure][4][]4}{[1][30][]32}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Modality deep dives and visual comparison.} \textbf  {a},~CASSI: PSNR across 4 scenarios for GAP-TV, MST-L, and HDNet; uniform collapse under Scenario~II ($20.83$--$21.88$\,dB) confirms operator-driven failure. \textbf  {b},~CACTI: four methods across 4 scenarios, showing up to $20.58$\,dB mismatch degradation. \textbf  {c--e},~Visual comparison (CASSI, CACTI, MRI): ground truth, Scenario~I, II (structured artifacts), III (PWM-corrected), and error map.}}{33}{figure.caption.115}\protected@file@percent }
\newlabel{fig:deepdive_visual}{{5}{33}{\textbf {Modality deep dives and visual comparison.} \textbf {a},~CASSI: PSNR across 4 scenarios for GAP-TV, MST-L, and HDNet; uniform collapse under Scenario~II ($20.83$--$21.88$\,dB) confirms operator-driven failure. \textbf {b},~CACTI: four methods across 4 scenarios, showing up to $20.58$\,dB mismatch degradation. \textbf {c--e},~Visual comparison (CASSI, CACTI, MRI): ground truth, Scenario~I, II (structured artifacts), III (PWM-corrected), and error map}{figure.caption.115}{}}
\newlabel{fig:deepdive_visual@cref}{{[figure][5][]5}{[1][30][]33}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Hardware validation on real CASSI and CACTI instruments.} \textbf  {a},~CASSI real data: measurement residual ratio (mismatched/calibrated) across 5 TSA scenes. GAP-TV shows $1.8\times $ mean ratio. \textbf  {b},~CACTI real data: residual ratio across 4 scenes. GAP-TV shows $10.4\times $ mean ratio; PnP-FFDNet shows $2.0\times $. \textbf  {c},~Simulation-to-hardware gap: comparing mismatch degradation in simulation versus real hardware for CASSI and CACTI. \textbf  {d},~Autonomous calibration: grid-search parameter recovery for CASSI (85\%), CACTI (100\%), and SPC (86--92\%).}}{34}{figure.caption.116}\protected@file@percent }
\newlabel{fig:hardware}{{6}{34}{\textbf {Hardware validation on real CASSI and CACTI instruments.} \textbf {a},~CASSI real data: measurement residual ratio (mismatched/calibrated) across 5 TSA scenes. GAP-TV shows $1.8\times $ mean ratio. \textbf {b},~CACTI real data: residual ratio across 4 scenes. GAP-TV shows $10.4\times $ mean ratio; PnP-FFDNet shows $2.0\times $. \textbf {c},~Simulation-to-hardware gap: comparing mismatch degradation in simulation versus real hardware for CASSI and CACTI. \textbf {d},~Autonomous calibration: grid-search parameter recovery for CASSI (85\%), CACTI (100\%), and SPC (86--92\%)}{figure.caption.116}{}}
