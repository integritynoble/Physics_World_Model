+def test_every_learnable_name_is_read_by_its_primitive():
+    """A name in ``learnable`` that the primitive never reads is a dead calibration parameter."""
+    import inspect
+    import re
+    import yaml
+    from pathlib import Path
+    root = Path(__file__).resolve().parent.parent / "contrib"
+    T = yaml.safe_load((root / "graph_templates.yaml").read_text())["templates"]
+    # primitives that are not in PRIMITIVE_REGISTRY under that id (aliases fixed elsewhere) are skipped
+    bad = []
+    for tid, t in T.items():
+        for n in t["nodes"]:
+            cls = PRIMITIVE_REGISTRY.get(n["primitive_id"])
+            if cls is None:
+                continue
+            src = inspect.getsource(cls)
+            for name in n.get("learnable") or []:
+                if not re.search(r"""['"]%s['"]""" % re.escape(name), src) and name not in ("gain", "sigma"):
+                    bad.append((tid, n["node_id"], n["primitive_id"], name))
+    assert not bad, bad
