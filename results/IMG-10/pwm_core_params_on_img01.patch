+    """(n, n) linear-interpolation matrix R with ``out[k] = in[c + (k - c) * scale - shift]``, c = (n - 1) / 2.
+
+    ``scale`` dilates the axis about its centre, ``shift`` translates it (in samples). Zero outside the axis.
+    The transpose is the exact adjoint of the resampling.
+    """
+    k = np.arange(n, dtype=np.float64)
+    c = (n - 1) / 2.0
+    pos = c + (k - c) * scale - shift
+    j0 = np.floor(pos).astype(int)
+    frac = pos - j0
+    R = np.zeros((n, n), dtype=np.float64)
+    for off, w in ((0, 1.0 - frac), (1, frac)):
+        j = j0 + off
+        ok = (j >= 0) & (j < n) & (w > 0)
+        R[k[ok].astype(int), j[ok]] += w[ok]
+    return R
+
