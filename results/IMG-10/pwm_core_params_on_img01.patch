+def test_templates_use_the_new_parameters():
+    import yaml
+    from pathlib import Path
+    root = Path(__file__).resolve().parent.parent / "contrib"
+    T = yaml.safe_load((root / "graph_templates.yaml").read_text())["templates"]
+    M = yaml.safe_load((root / "mismatch_db.yaml").read_text())
+    M = M.get("modalities", M)
+
+    def node(tid, nid):
+        return next(n for n in T[tid]["nodes"] if n["node_id"] == nid)
+
+    for tid in ("ct_graph_v1", "ct_graph_v2", "cbct_graph_v2"):
+        n = node(tid, "radon")
+        assert {"detector_offset", "angle_offset"} <= set(n["params"]) <= set(n["params"])
+        assert {"detector_offset", "angle_offset"} <= set(n["learnable"])
+    for tid in ("ultrasound_graph_v2", "photoacoustic_graph_v2"):
+        assert "speed_of_sound" in node(tid, "propagate")["learnable"]
+    assert M["ct"]["graph_param_map"]["detector_offset"] == "radon.detector_offset"
+    assert M["ultrasound"]["graph_param_map"]["speed_of_sound"] == "propagate.speed_of_sound"
+    # removed parameters are recorded, not lost
+    assert node("tem_graph_v2", "source")["params"].get("accelerating_voltage_kv") is None
+    assert T["tem_graph_v2"]["metadata"]["unmodelled_params"]["source.accelerating_voltage_kv"] == 200.0
+
