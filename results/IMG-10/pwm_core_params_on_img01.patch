+"""Template parameters must act, and the calibration parameters added for geometry must be exact (LIB-40 IMG-10).
+
+* each new parameter changes the forward output, is the identity at its nominal value, and has an adjoint
+  that is the exact transpose of the forward;
+* the template parameters that used to be dead (the primitive never read the name) now act, or have been moved to
+  ``metadata.unmodelled_params``.
+"""
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from pwm_core.graph.primitives import PRIMITIVE_REGISTRY
+
+
+def _prim(pid, **params):
+    return PRIMITIVE_REGISTRY[pid](params)
+
+
+def _dot_test(op, x, rng, atol=1e-9):
+    y = op.forward(x)
+    z = rng.standard_normal(np.shape(y))
+    lhs = float(np.sum(y * z))
+    rhs = float(np.sum(x * op.adjoint(z)))
+    return abs(lhs - rhs) / (abs(lhs) + 1e-12)
+
+
+def test_ct_detector_offset_shifts_sinogram_and_is_exact_adjoint():
+    rng = np.random.default_rng(0)
+    x = rng.random((16, 16))
+    base = _prim("ct_radon", n_angles=12, H=16, W=16)
+    shifted = _prim("ct_radon", n_angles=12, H=16, W=16, detector_offset=2.0)
+    ys0, ys = base.forward(x), shifted.forward(x)
+    np.testing.assert_allclose(ys[:, 2:], ys0[:, :-2], atol=1e-12)
+    np.testing.assert_allclose(ys[:, :2], 0.0, atol=1e-12)
+    assert _dot_test(shifted, x, rng) < 1e-10
+    frac = _prim("ct_radon", n_angles=12, H=16, W=16, detector_offset=0.5)
+    assert np.abs(frac.forward(x) - ys0).max() > 1e-6
+    assert _dot_test(frac, x, rng) < 1e-10
+
+
+def test_ct_detector_offset_zero_is_identity_and_acts_without_matrix():
+    rng = np.random.default_rng(1)
+    x = rng.random((40, 40))  # 1600 > 1024: no explicit matrix, rotation path
+    a = _prim("ct_radon", n_angles=8, H=40, W=40)
+    b = _prim("ct_radon", n_angles=8, H=40, W=40, detector_offset=0.0)
+    c = _prim("ct_radon", n_angles=8, H=40, W=40, detector_offset=1.5)
+    np.testing.assert_array_equal(a.forward(x), b.forward(x))
+    assert np.abs(a.forward(x) - c.forward(x)).max() > 1e-6
+    # the adjoint of the shift is applied to the sinogram before backprojection
+    y = rng.random((8, 40))
+    S = c._S
+    np.testing.assert_allclose(c.adjoint(y), a.adjoint(y @ S), atol=1e-12)
+
+
+def test_acoustic_speed_of_sound_acts_identity_at_nominal_exact_adjoint():
+    rng = np.random.default_rng(2)
+    x = rng.random((24, 24))
+    kw = dict(n_sensors=12, x_shape=[24, 24])
+    nominal = _prim("acoustic_propagation", speed_of_sound=1540.0, **kw)
+    default = _prim("acoustic_propagation", **kw)
+    fast = _prim("acoustic_propagation", speed_of_sound=1540.0 * 1.05, **kw)
+    slow = _prim("acoustic_propagation", speed_of_sound=1540.0 * 0.95, **kw)
+    np.testing.assert_array_equal(nominal.forward(x), default.forward(x))
+    assert np.abs(fast.forward(x) - nominal.forward(x)).max() > 1e-6
+    assert np.abs(slow.forward(x) - fast.forward(x)).max() > 1e-6
+    # the nominal speed moves the identity point
+    shifted_nominal = _prim("acoustic_propagation", speed_of_sound=1500.0, nominal_speed=1500.0, **kw)
+    np.testing.assert_array_equal(shifted_nominal.forward(x), default.forward(x))
+    # exact transpose of the time-axis resampling (the rest of the adjoint is the existing approximation)
+    R = fast._time_axis_matrix(24)
+    y = rng.random((12, 24))
+    z = rng.random((12, 24))
+    np.testing.assert_allclose(np.sum((y @ R.T) * z), np.sum(y * (z @ R)), rtol=1e-12)
+
+
+def test_coded_mask_density_and_shift():
+    default = _prim("coded_mask", seed=3, H=32, W=32)
+    half = _prim("coded_mask", seed=3, H=32, W=32, density=0.5)
+    sparse = _prim("coded_mask", seed=3, H=32, W=32, density=0.2)
+    np.testing.assert_array_equal(default._mask, half._mask)
+    assert abs(sparse._mask.mean() - 0.2) < 0.05
+    shifted = _prim("coded_mask", seed=3, H=32, W=32, mask_dx=1.0, mask_dy=0.0)
+    np.testing.assert_allclose(shifted._mask[:, 1:], default._mask[:, :-1], atol=1e-12)
+    sub = _prim("coded_mask", seed=3, H=32, W=32, mask_dx=0.4)
+    assert np.abs(sub._mask - default._mask).max() > 0.1
+    rng = np.random.default_rng(4)
+    assert _dot_test(sub, rng.random((32, 32)), rng) < 1e-12
+
+
+def test_temporal_mask_shift_acts():
+    a = _prim("temporal_mask", H=16, W=16, T=4, seed=1)
+    b = _prim("temporal_mask", H=16, W=16, T=4, seed=1, mask_dx=0.5)
+    x = np.random.default_rng(5).random((16, 16, 4))
+    assert np.abs(a.forward(x) - b.forward(x)).max() > 1e-6
+
+
+def test_objective_lens_vignetting_acts_with_exact_adjoint():
+    rng = np.random.default_rng(6)
+    x = rng.random((20, 20, 3))
+    a = _prim("objective_lens", throughput=0.9, psf_sigma=0.8)
+    b = _prim("objective_lens", throughput=0.9, psf_sigma=0.8, vignetting=0.3)
+    np.testing.assert_array_equal(a.forward(x), _prim("objective_lens", throughput=0.9, psf_sigma=0.8, vignetting=0.0).forward(x))
+    assert np.abs(a.forward(x) - b.forward(x)).max() > 1e-3
+    assert _dot_test(b, x, rng) < 1e-10
+
+
+def test_small_gains_act():
+    x = np.random.default_rng(7).random((8, 8))
+    for pid, base, changed in (
+        ("sequence_block", {}, {"flip_angle_deg": 30.0}),
+        ("electron_detector_sensor", {}, {"dqe": 0.5}),
+        ("electron_beam_source", {}, {"beam_current_na": 2.0}),
+    ):
+        p0, p1 = _prim(pid, **base), _prim(pid, **changed)
+        assert np.abs(p0.forward(x) - p1.forward(x)).max() > 1e-6
+        assert np.allclose(p0.forward(x) * 0, 0)  # no NaN
+    # a source passes the object through: the output depends on x
+    src = _prim("electron_beam_source", beam_current_na=0.1)
+    assert np.abs(src.forward(x) - src.forward(2 * x)).max() > 1e-6
+    # 90 degrees is the identity of the flip-angle factor
+    np.testing.assert_allclose(_prim("sequence_block").forward(x), _prim("sequence_block", flip_angle_deg=90.0).forward(x))
+
