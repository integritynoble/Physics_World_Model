# ══════════════════════════════════════════════════════════════════════
# PWM Platform — Environment Variables
# ══════════════════════════════════════════════════════════════════════
# SECURITY: Copy this file to .env and fill in real values.
#           NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────
APP_NAME=PWM Platform
APP_VERSION=0.1.0
DEBUG=false
APP_PORT=8000
LOG_LEVEL=INFO

# ── Auth / Security ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
CSRF_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT=10

# ── SSO (CompareGPT-compatible) ─────────────────────────────────────
# Leave empty to disable SSO and use local login only
SSO_VALIDATE_URL=
SSO_REDIRECT_URL=

# ── Database (PostgreSQL on CPU server) ──────────────────────────────
# Used internally by docker-compose; the app container overrides this
DB_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_16
DATABASE_URL=postgresql+asyncpg://pwm:CHANGE_ME@localhost:5432/pwm

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://pwm.platformai.org"]

# ── Modal (GPU workers — on-demand) ──────────────────────────────────
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Gemini (Spec Builder chat) ─────────────────────────────────────
PWM_GEMINI_API_KEY=

# ── GCP (canonical dataset storage) ─────────────────────────────────
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_PROJECT=
BIGQUERY_DATASET=pwm_analytics
