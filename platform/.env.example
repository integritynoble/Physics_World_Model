# platform/.env.example
# Copy to .env, fill in real values. NEVER commit .env to git.

DATABASE_URL=postgresql+asyncpg://pwm_user:CHANGE_ME_DB_PASSWORD@db:5432/pwm_db
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_USER=pwm_user
POSTGRES_DB=pwm_db

REDIS_URL=redis://redis:6379/0

# Modal (run: modal token new  — only needed if using GPU mode)
MODAL_TOKEN_ID=CHANGE_ME_MODAL_TOKEN_ID
MODAL_TOKEN_SECRET=CHANGE_ME_MODAL_TOKEN_SECRET

# App
SECRET_KEY=CHANGE_ME_RANDOM_64_CHAR_HEX
ENVIRONMENT=production
LOG_LEVEL=INFO

# PWM — local workspace (no GCS required)
PWM_WORKSPACE_DIR=/data/workspace
PWM_CASEPACK_DIR=/app/packages/pwm_core/contrib/casepacks

# Grafana (optional monitoring)
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
